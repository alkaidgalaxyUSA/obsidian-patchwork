{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2021",
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2021"],
    "types": ["node"],
    "strict": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true
  },
  "include": ["borders/src/**/*", "project/src/**/*", "content/src/**/*", "content/code-editor/src/**/*", "claudian/src/**/*", "git/src/**/*", "terminal/src/**/*", "contracts/**/*", "utils/**/*"],
  "exclude": ["node_modules", "dist"]
}
