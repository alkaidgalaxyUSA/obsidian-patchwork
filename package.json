{
  "name": "obsidian-patchwork",
  "version": "0.1.0",
  "private": true,
  "description": "Independent Obsidian theme and plugin enhancements with local packaging tools.",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pwsh -NoProfile -File scripts/Build-Install.ps1",
    "typecheck": "tsc --project plugins/tsconfig.json"
  },
  "devDependencies": {
    "sass": "1.106.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "obsidian": "1.14.4",
    "tslib": "2.8.1",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alkaidgalaxyUSA/obsidian-patchwork.git"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "highlight.js": "11.12.0"
  },
  "overrides": {
    "@codemirror/language": "$@codemirror/language",
    "@codemirror/state": "$@codemirror/state",
    "@codemirror/view": "$@codemirror/view"
  }
}
